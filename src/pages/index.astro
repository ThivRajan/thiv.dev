---
import Experience from '@components/Experience/Experience'
import Hero from '@components/Hero/Hero'
import Projects from '@components/Projects/Projects'
import './index.scss'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Namdhinggo:wght@400;500;600;700;800&display=swap&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<title>Thiv Rajan</title>
	</head>
	<body>
		<div
			class="h-screen min-h-full flex justify-center overflow-auto relative mt-[3rem]"
		>
			<div class="flex flex-col w-full h-max p-6 max-w-xl gap-8">
				<Hero client:idle />
				<Experience client:idle />
				<Projects client:idle />
			</div>
		</div>
	</body>
</html>
